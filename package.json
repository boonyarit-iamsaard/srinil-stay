{
  "name": "grammar-correction-tool",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "db:down": "turbo -F @grammar-correction-tool/db db:down",
    "db:generate": "turbo -F @grammar-correction-tool/db db:generate",
    "db:migrate": "turbo -F @grammar-correction-tool/db db:migrate",
    "db:push": "turbo -F @grammar-correction-tool/db db:push",
    "db:start": "turbo -F @grammar-correction-tool/db db:start",
    "db:stop": "turbo -F @grammar-correction-tool/db db:stop",
    "db:studio": "turbo -F @grammar-correction-tool/db db:studio",
    "db:watch": "turbo -F @grammar-correction-tool/db db:watch",
    "dev": "turbo dev",
    "dev:server": "turbo -F server dev",
    "dev:web": "turbo -F web dev",
    "fix": "ultracite fix",
    "prepare": "husky",
    "types:check": "turbo types:check"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@grammar-correction-tool/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@grammar-correction-tool/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.8.1"
  },
  "packageManager": "pnpm@11.5.1"
}
