BACK_OFFICE_URL=http://localhost:4000

# Must be at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secure-32-char-min-secret
BETTER_AUTH_URL=http://localhost:5000

CORS_ORIGIN=http://localhost:4000,http://localhost:3000

DATABASE_URL=postgresql://postgres:password@postgres:5432/srinil-stay

MAIL_FROM=Srinil Stay <no-reply@srinilstay.local>
SMTP_HOST=mailpit
SMTP_PORT=1025

# First-Staff bootstrap (opt-in). When both are set, the server issues a Staff
# invitation for this person on startup. Leave unset once the first Staff exists.
# See docs/adr/0004-bootstrap-first-staff-via-on-boot-invitation.md
# BOOTSTRAP_STAFF_EMAIL=owner@example.com
# BOOTSTRAP_STAFF_NAME=Owner
